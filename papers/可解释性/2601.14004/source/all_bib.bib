@inproceedings{diminoTracingPositionalBias2025,
  title = {Tracing {{Positional Bias}} in {{Financial Decision-Making}}: {{Mechanistic Insights}} from {{Qwen2}}.5},
  shorttitle = {Tracing {{Positional Bias}} in {{Financial Decision-Making}}},
  booktitle = {Proceedings of the 6th {{ACM International Conference}} on {{AI}} in {{Finance}}},
  author = {Dimino, Fabrizio and Saxena, Krati and Sarmah, Bhaskarjit and Pasquali, Stefano},
